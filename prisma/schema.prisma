datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// ═══════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════

enum VerificationTokenStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

enum PasswordResetTokenStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

enum SessionStatus {
  CREATED
  ACTIVE
  EXPIRED
  INVALIDATED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  FAILED
}

enum UserStatus {
  NEW
  PENDING_ACTIVATION
  INVITED
  ACTIVE
  SUSPENDED
  TERMINATED
}

// ABAC scope bound to a UserRole assignment.
// OWN          = user sees only records they own
// TEAM         = user sees all records owned by teammates
// DEPARTMENT   = user sees all records owned by departmental members
// ORGANIZATION = user sees all records in the tenant
enum ScopeType {
  OWN
  TEAM
  DEPARTMENT
  ORGANIZATION
}

// Removed V2 enums

enum OrganizationStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Removed assignment/domain event enums

// ═══════════════════════════════════════════════════════════════════
// S1 FOUNDATION — AUTH, USERS, ROLES, SESSIONS
// ═══════════════════════════════════════════════════════════════════

model Tenant {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  status             OrganizationStatus @default(PROVISIONING)
  subscriptionPlanId String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  roles            Role[]
  users            User[]
  userInvitations  UserInvitation[]
  sessions         Session[]
  opportunityTypes OpportunityType[]
  departments      Department[]
  teams            Team[]
  docPresets       DocPreset[]
  docCases         DocCase[]

  settings TenantSettings?

  @@index([status])
  @@index([deletedAt])
}

// ─── Organizational Hierarchy ─────────────────────────────────────

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([tenantId])
}

model Team {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  departmentId String? @db.Uuid
  name         String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([tenantId, departmentId])
}

// ─── Roles & Permissions ──────────────────────────────────────────

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  users           UserRole[]
  userInvitations UserInvitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
}

// Global permissions (not tenant-scoped).
// Slugs are the canonical reference: "lead:view", "contact:create", etc.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique
  module      String
  description String

  roles RolePermission[]
}

// Junction table — composite PK, NO soft-delete (physical deletes only).
model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// Junction table — composite PK, NO soft-delete (physical deletes only).
// scopeType determines ABAC data-access scope for this role assignment.
model UserRole {
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  scopeType ScopeType @default(OWN)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
}

// ─── Users ────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @db.Uuid
  email             String
  emailVerified     DateTime?
  verifiedAt        DateTime?
  password          String
  status            UserStatus @default(NEW)
  teamId            String?    @db.Uuid
  departmentId      String?    @db.Uuid
  suspendedAt       DateTime?
  suspensionReason  String?
  terminatedAt      DateTime?
  terminationReason String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  team                Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  userRoles           UserRole[]
  invitedUsers        UserInvitation[]     @relation("InvitedBy")
  acceptedInvitations UserInvitation[]     @relation("AcceptedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@index([teamId, deletedAt])
  @@index([departmentId, deletedAt])
  @@index([tenantId, deletedAt])
}

model UserInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  email      String
  status     InvitationStatus @default(PENDING)
  roleId     String           @db.Uuid
  token      String           @unique
  expiresAt  DateTime
  invitedBy  String           @db.Uuid
  acceptedBy String?          @db.Uuid
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  inviter  User   @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)
  acceptor User?  @relation("AcceptedBy", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@index([token])
  @@index([deletedAt])
}

model Session {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  userId            String        @db.Uuid
  status            SessionStatus @default(CREATED)
  refreshTokenHash  String
  expiresAt         DateTime
  lastActivityAt    DateTime?
  revokedAt         DateTime?
  invalidatedAt     DateTime?
  expiredAt         DateTime?
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  riskScore         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([deletedAt])
  @@index([tenantId, userId, status])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  eventType      String
  entityType     String
  entityId       String
  actorUserId    String?  @db.Uuid
  actorIp        String?
  actorUserAgent String?
  operation      String
  payload        Json
  beforeState    Json?
  afterState     Json?
  correlationId  String?  @db.Uuid
  previousHash   String?  @db.Char(64)
  currentHash    String   @db.Char(64)
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@index([entityType, entityId])
  @@index([currentHash])
}

// ═══════════════════════════════════════════════════════════════════
// S2 CRM DOMAIN
// ═══════════════════════════════════════════════════════════════════

enum LeadPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EMAIL_CAMPAIGN
  SOCIAL_MEDIA
  TRADE_SHOW
  OTHER
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum OpportunityCurrency {
  INR
  USD
  EUR
  GBP
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

// ─── Lead ─────────────────────────────────────────────────────────
model Lead {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  firstName         String
  lastName          String
  email             String?
  phone             String?
  company           String?
  source            LeadSource   @default(OTHER)
  status            LeadStatus   @default(NEW)
  stage             LeadStage    @default(NEW)
  score             Int          @default(0)
  expectedValue     Decimal      @default(0) @db.Decimal(18, 2)
  priority          LeadPriority @default(MEDIUM)
  expectedCloseDate DateTime?
  country           String?
  state             String?
  city              String?
  area              String?
  postalCode        String?
  freeformAddress   String?
  ownerId           String?      @db.Uuid
  notes             String?
  customFieldValues Json         @default("[]")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  contacts      Contact[]
  opportunities Opportunity[]
  docCases      DocCase[]
  tags          LeadTagAssignment[]
  leadNotes     LeadNote[] @relation("LeadNotes")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, ownerId])
  @@index([deletedAt])
}

// ─── LeadNote — chronological note history with same-day editing ─────
model LeadNote {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  leadId        String    @db.Uuid
  authorId      String    @db.Uuid
  content       String    @db.VarChar(500)
  followUpDate  DateTime?
  followUpTime  String?   // HH:mm stored as string for timezone handling
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  lead Lead @relation("LeadNotes", fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([tenantId])
  @@index([createdAt])
}

// ─── LeadFieldDef — tenant-scoped custom field definitions ──────
model LeadFieldDef {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  key       String
  type      String   // text | number | date | dropdown
  options   Json     @default("[]") // string[] for dropdown type
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ─── LeadTag — tenant-scoped tag catalog ─────────────────────────
model LeadTag {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  color      String?   @default("#6366f1")
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  assignments LeadTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
}

// ─── LeadTagAssignment — many-to-many junction ───────────────────
model LeadTagAssignment {
  leadId String @db.Uuid
  tagId  String @db.Uuid

  lead Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([leadId])
  @@index([tagId])
}

// ─── Contact ──────────────────────────────────────────────────────
model Contact {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  leadId    String?   @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  company   String?
  role      String?
  isMain    Boolean   @default(false)
  ownerId   String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@index([tenantId, ownerId])
  @@index([deletedAt])
}

// ─── OpportunityType ──────────────────────────────────────────────
model OpportunityType {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  name         String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
}

// ─── Opportunity ──────────────────────────────────────────────────
model Opportunity {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  leadId                String              @db.Uuid
  contactId             String?             @db.Uuid
  ownerId               String              @db.Uuid
  opportunityTypeId     String?             @db.Uuid
  customOpportunityType String?
  title                 String
  value                 Decimal             @db.Decimal(18, 2)
  currency              OpportunityCurrency @default(INR)
  stage                 OpportunityStage    @default(PROSPECTING)
  expectedCloseDate     DateTime?
  closedAt              DateTime?
  lostReason            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityType OpportunityType? @relation(fields: [opportunityTypeId], references: [id], onDelete: Restrict)
  activities      Activity[]
  pipeline        Pipeline[]
  invoices        Invoice[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
  @@index([tenantId, opportunityTypeId])
  @@index([tenantId, expectedCloseDate])
  @@index([deletedAt])
}

// ─── Activity ─────────────────────────────────────────────────────
model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  opportunityId String       @db.Uuid
  userId        String       @db.Uuid
  type          ActivityType
  subject       String
  notes         String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, userId])
  @@index([tenantId, type])
  @@index([deletedAt])
}

// ─── Pipeline ─────────────────────────────────────────────────────
model Pipeline {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  opportunityId String           @db.Uuid
  stage         OpportunityStage
  enteredAt     DateTime         @default(now())
  exitedAt      DateTime?
  durationDays  Int?
  createdAt     DateTime         @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, stage])
}

// ═══════════════════════════════════════════════════════════════════
// S3 FINANCE DOMAIN
// ═══════════════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  NEFT
  RTGS
  IMPS
  OTHER
}

enum PaymentStatus {
  PENDING
  RECEIVED
  FAILED
  REFUNDED
  CANCELLED
}

// ─── Invoice ──────────────────────────────────────────────────────
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  opportunityId   String        @db.Uuid
  invoiceNumber   String?
  invoiceDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(18, 2)
  taxPercentage   Decimal?      @default(0) @db.Decimal(5, 2)
  discount        Decimal?      @default(0) @db.Decimal(18, 2)
  otherCharges    Decimal?      @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal?      @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal       @db.Decimal(18, 2)
  paymentTerms    String?
  internalNotes   String?
  invoiceNotes    String?
  termsConditions String?
  attachments     String[]      @default([])
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([tenantId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, status])
  @@index([deletedAt])
}

// ─── Payment ──────────────────────────────────────────────────────
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  invoiceId       String        @db.Uuid
  amount          Decimal       @db.Decimal(18, 2)
  method          PaymentMethod @default(CASH)
  referenceNumber String?
  bankName        String?
  chequeNumber    String?
  status          PaymentStatus @default(PENDING)
  receivedBy      String?
  notes           String?
  attachmentUrl   String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([deletedAt])
}

model VerificationToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String
  tokenHash String                  @unique
  status    VerificationTokenStatus @default(PENDING)

  usedAt    DateTime?
  revokedAt DateTime?
  expiresAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, status, expiresAt])
  @@index([tokenHash, status])
}

model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String                   @unique
  status    PasswordResetTokenStatus @default(PENDING)

  usedAt    DateTime?
  revokedAt DateTime?
  expiresAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, status, expiresAt])
  @@index([tokenHash, status])
}

// Removed S4 V2 AUTH & IDENTITY MODELS and OutboxEvent

// ═══════════════════════════════════════════════════════════════════
// S4 DOCUMENTATION TRACKER DOMAIN
// Workflow orchestration — NOT a document storage system.
// The CRM tracks readiness, metadata, and audit. Documents live elsewhere.
// ═══════════════════════════════════════════════════════════════════

enum DocPresetCategory {
  GOVERNMENT
  FINANCIAL
  LEGAL
  OPERATIONAL
  COMPLIANCE
  CUSTOM
}

enum DocDocumentStatus {
  REQUESTED
  PENDING_COLLECTION
  RECEIVED
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  RE_REQUESTED
  EXPIRED
  NOT_APPLICABLE
  WAIVED
  MANAGER_APPROVED
}

enum DocCaseStatus {
  ACTIVE
  DOCUMENTATION_READY
  TRANSFERRED_TO_PROCESS
  CLOSED
  CANCELLED
}

enum DocNoteType {
  INTERNAL
  CUSTOMER
}

enum DocStorageType {
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
  SHAREPOINT
  NAS_PATH
  LOCAL_FOLDER
  PHYSICAL_CABINET
  REFERENCE_NUMBER
  EMAIL
  EXTERNAL_PORTAL
  STORED_OFFLINE
  OTHER
}

enum DocEventType {
  CASE_CREATED
  PRESET_APPLIED
  DOCUMENT_STATUS_CHANGED
  DOCUMENT_RECEIVED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  DOCUMENT_WAIVED
  DOCUMENT_APPROVED
  REMINDER_SENT
  NOTE_ADDED
  STORAGE_REF_ADDED
  MANAGER_OVERRIDE
  TRANSFERRED_TO_PROCESS
  CASE_CLOSED
  CASE_CANCELLED
  EXPIRY_WARNING
}

// ─── DocPreset — reusable document requirement template ───────────
model DocPreset {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  name        String
  description String?
  category    DocPresetCategory @default(CUSTOM)
  color       String?
  icon        String?
  isActive    Boolean           @default(true)
  version     Int               @default(1)
  usageCount  Int               @default(0)
  createdBy   String            @db.Uuid
  updatedBy   String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          DocPresetItem[]
  versionHistory DocPresetVersion[]
  cases          DocCase[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([deletedAt])
}

// ─── DocPresetItem — individual document definition in a preset ───
model DocPresetItem {
  id                    String   @id @default(uuid()) @db.Uuid
  presetId              String   @db.Uuid
  tenantId              String   @db.Uuid
  name                  String
  description           String?
  isMandatory           Boolean  @default(true)
  isBlocking            Boolean  @default(false)
  displayOrder          Int      @default(0)
  verificationRequired  Boolean  @default(true)
  expiryTrackingEnabled Boolean  @default(false)
  expiryDays            Int?
  metadataFields        Json     @default("[]")
  notes                 String?
  conditionRule         Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  preset DocPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId])
  @@index([tenantId])
  @@index([deletedAt])
}

// ─── DocPresetVersion — immutable snapshot; old cases are never affected ─
model DocPresetVersion {
  id         String   @id @default(uuid()) @db.Uuid
  presetId   String   @db.Uuid
  tenantId   String   @db.Uuid
  version    Int
  snapshot   Json
  changedBy  String   @db.Uuid
  changeNote String?
  createdAt  DateTime @default(now())

  preset DocPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([presetId, version])
  @@index([tenantId])
  @@index([presetId, createdAt])
}

// ─── DocCase — one documentation tracking case per lead ──────────
model DocCase {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  leadId            String        @db.Uuid
  presetId          String?       @db.Uuid
  presetVersion     Int?
  assignedTo        String?       @db.Uuid
  status            DocCaseStatus @default(ACTIVE)
  priority          Int           @default(0)
  totalDocs         Int           @default(0)
  receivedDocs      Int           @default(0)
  verifiedDocs      Int           @default(0)
  approvedDocs      Int           @default(0)
  rejectedDocs      Int           @default(0)
  mandatoryDocs     Int           @default(0)
  mandatoryApproved Int           @default(0)
  completionPercent Int           @default(0)
  isReady           Boolean       @default(false)
  dueDate           DateTime?
  transferredAt     DateTime?
  transferredBy     String?       @db.Uuid
  closedAt          DateTime?
  notes             String?
  createdBy         String        @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead      Lead                 @relation(fields: [leadId], references: [id], onDelete: Restrict)
  preset    DocPreset?           @relation(fields: [presetId], references: [id], onDelete: SetNull)
  documents DocCaseDocument[]
  events    DocCaseEvent[]
  caseNotes DocCaseNote[]
  reminders DocReminder[]
  overrides DocManagerOverride[]

  @@unique([tenantId, leadId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, isReady])
  @@index([deletedAt])
}

// ─── DocCaseDocument — individual document tracking entry ─────────
model DocCaseDocument {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  caseId                String            @db.Uuid
  presetItemId          String?           @db.Uuid
  name                  String
  description           String?
  isMandatory           Boolean           @default(true)
  isBlocking            Boolean           @default(false)
  displayOrder          Int               @default(0)
  verificationRequired  Boolean           @default(true)
  expiryTrackingEnabled Boolean           @default(false)
  expiryDate            DateTime?
  status                DocDocumentStatus @default(REQUESTED)
  receivedAt            DateTime?
  verifiedAt            DateTime?
  verifiedBy            String?           @db.Uuid
  verificationRemarks   String?
  rejectionReason       String?
  isWaived              Boolean           @default(false)
  waivedBy              String?           @db.Uuid
  waivedReason          String?
  metadataValues        Json              @default("{}")
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  case        DocCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  storageRefs DocStorageRef[]
  events      DocCaseEvent[]

  @@index([caseId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([deletedAt])
}

// ─── DocCaseEvent — append-only event timeline ────────────────────
model DocCaseEvent {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  caseId          String             @db.Uuid
  documentId      String?            @db.Uuid
  eventType       DocEventType
  actorUserId     String?            @db.Uuid
  actorDepartment String?
  fromStatus      DocDocumentStatus?
  toStatus        DocDocumentStatus?
  remarks         String?
  payload         Json               @default("{}")
  createdAt       DateTime           @default(now())

  case     DocCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document DocCaseDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([tenantId])
}

// ─── DocCaseNote — internal or customer-facing notes ──────────────
model DocCaseNote {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  caseId    String      @db.Uuid
  noteType  DocNoteType @default(INTERNAL)
  content   String
  createdBy String      @db.Uuid
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  case DocCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([tenantId])
}

// ─── DocStorageRef — optional informational storage reference ─────
// The CRM never reads or depends on these paths. Informational only.
model DocStorageRef {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  documentId  String         @db.Uuid
  storageType DocStorageType
  reference   String
  label       String?
  addedBy     String         @db.Uuid
  createdAt   DateTime       @default(now())

  document DocCaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([tenantId])
}

// ─── DocReminder — reminder scheduling per case/document ─────────
model DocReminder {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  caseId          String    @db.Uuid
  documentId      String?   @db.Uuid
  reminderDate    DateTime
  dueDate         DateTime?
  escalationLevel Int       @default(0)
  message         String?
  isTriggered     Boolean   @default(false)
  triggeredAt     DateTime?
  createdBy       String    @db.Uuid
  createdAt       DateTime  @default(now())

  case DocCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([tenantId, reminderDate])
}

// ─── DocManagerOverride — audited override when case is incomplete ─
model DocManagerOverride {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  caseId       String    @db.Uuid
  overriddenBy String    @db.Uuid
  reason       String
  allowedAt    DateTime  @default(now())
  expiresAt    DateTime?

  case DocCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([tenantId])
}

model TenantSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @unique @db.Uuid
  maxConcurrentSessions Int      @default(10)
  sessionLifetimeDays   Int      @default(30)
  mfaRequired           Boolean  @default(false)
  allowedIpRanges       String[] @default([])
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
