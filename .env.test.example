# .env.test — LOCAL ONLY — never commit this file
# Copy to .env.test and fill in a LOCAL PostgreSQL database for running integration tests.
# This file overrides .env when running jest, to prevent tests from hitting production.
#
# Create a local test database:
#   createdb hpx_local_test
#   npx prisma migrate deploy   # (with DATABASE_URL set to this URL)
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hpx_local_test
JWT_SECRET=local-test-jwt-secret-not-for-production
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
NODE_ENV=test
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_test_placeholder
