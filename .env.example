# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/dbname_shadow

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-with-openssl-rand-base64-64
# RS256 keys — generate with: openssl genrsa 4096 | openssl pkcs8 -topk8 -nocrypt
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── WhatsApp webhook (POST /api/v1/whatsapp/webhook) ─────────────────────────
# Required for the webhook to accept requests — without it the endpoint fails closed (503).
# Sender signs: x-webhook-signature = hex HMAC-SHA256(`${unixSeconds}.${rawBody}`)
#               x-webhook-timestamp = unix seconds (±5 min accepted)
WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# ── Redis (rate limiting + permission cache) ─────────────────────────────────
# Required: the public mandate endpoints (upload-url, confirm-upload) fail closed
# with 503 when Redis is unavailable, because their per-token rate limiter is
# fail-closed. Local dev: point at a local redis-server. An empty value (REDIS_URL=)
# means unconfigured — rate limiters fail-open and the permission cache uses the DB.
REDIS_URL=redis://127.0.0.1:6379

# ── Cloudflare R2 (mandate document storage) ─────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hpx-eigen-mandates
MANDATE_UPLOAD_BASE_URL=https://app.hpxeigen.com/mandate/upload

# ── Virus scanning (ClamAV / clamd) ──────────────────────────────────────────
# Mandate uploads are scanned via clamd INSTREAM before promotion to mandate-uploads/.
# VIRUS_SCAN_ENABLED=true turns scanning on; when off in production, mandate uploads
# fail closed (503 SCANNER_UNAVAILABLE). Leave off only for local dev.
VIRUS_SCAN_ENABLED=false
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
VIRUS_SCAN_TIMEOUT_MS=10000

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Seed (development/local only — NEVER set SEED_DATABASE=true in production) ─
# Credentials are read from env at runtime — never commit plaintext passwords
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Comma-separated list of emails to grant Organization Admin when running seed-permissions
SEED_ADMIN_EMAILS=admin@example.com
