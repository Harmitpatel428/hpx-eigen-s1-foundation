# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/dbname_shadow

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-64
# RS256 keys — generate with: openssl genrsa 4096 | openssl pkcs8 -topk8 -nocrypt
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Seed (development/local only — NEVER set SEED_DATABASE=true in production) ─
# Credentials are read from env at runtime — never commit plaintext passwords
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Comma-separated list of emails to grant Organization Admin when running seed-permissions
SEED_ADMIN_EMAILS=admin@example.com
