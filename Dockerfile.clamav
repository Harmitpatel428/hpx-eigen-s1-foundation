# ─────────────────────────────────────────────────────────────────────────────
# Backend runtime WITH an in-container ClamAV daemon for mandate virus scanning.
#
# Point Render's Docker runtime at THIS file (Dockerfile.clamav) to enable
# production uploads. clamd binds 127.0.0.1:3310 ONLY and is never exposed;
# supervisord runs clamd, freshclam, and the Node app together in one container.
#
# Deviations from the original spec, and why:
#   * Separate file (Dockerfile.clamav) — leaves the existing Dockerfile intact.
#   * Full `npm ci` (not --omit=dev): `npm run build` (tsc) and the runtime
#     prisma CLI both need devDependencies, so --omit=dev would break them.
#   * The app applies pending schema at startup (see supervisord.conf),
#     preserving the behavior of the existing Dockerfile.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim

# clamd (scanner), freshclam (updater), supervisor (process mgr), and
# ca-certificates (slim image omits it; freshclam needs it for HTTPS DB downloads).
RUN apt-get update  && apt-get install -y --no-install-recommends       ca-certificates clamav-daemon clamav-freshclam supervisor  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install ALL deps first (build + runtime prisma CLI need devDependencies).
# --ignore-scripts skips the root postinstall (`prisma generate`), which needs
# prisma/schema.prisma — not copied at this layer. Keeping this COPY limited to
# package*.json preserves the Docker cache: the install layer only rebuilds when
# dependencies change, not on every source edit.
COPY package*.json ./
RUN npm ci --ignore-scripts

# Now the full source (incl. prisma/) is present. `npm run build` is
# `prisma generate && tsc`: it generates the Prisma Client (schema now available)
# BEFORE tsc, which needs the generated types.
COPY . .
RUN npm run build

# Scanner + process-manager configs.
COPY deploy/clamd.conf        /etc/clamav/clamd.conf
COPY deploy/freshclam.conf    /etc/clamav/freshclam.conf
COPY deploy/supervisord.conf  /etc/supervisor/supervisord.conf

# Bake the virus signature DB into the image so clamd is ready on first boot
# (no cold-start wait for the first freshclam download). Ensure the DB + log
# dirs exist first (UpdateLogFile writes to /var/log/clamav).
RUN mkdir -p /var/lib/clamav /var/log/clamav \
 && freshclam --config-file=/etc/clamav/freshclam.conf

# Only the HTTP app port is exposed. clamd 3310 is loopback-only and NOT exposed.
EXPOSE 3000

ENTRYPOINT ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
